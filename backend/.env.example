# Fixly API Environment Variables Example
# Copy this file to .env and fill in the values

# Database
# DATABASE_URL=sqlite:///./sql_app.db
# DATABASE_URL=postgresql://user:password@hostname:5432/dbname

# Authentication & Security
ADMIN_PASSWORD=YourSuperSecureAdminPassword2026!
VIEWER_PASSWORD=YourSecureViewerPassword2026!
DEFAULT_USER_PASSWORD=YourSecureDefaultPassword2026!
JWT_SECRET_KEY=generate_a_random_secure_string_here

# CORS Configuration
# Comma-separated list of allowed origins. Use * for development only.
ALLOWED_ORIGINS=http://localhost:5173,https://your-production-domain.com

# Integrations (Optional)
SUPABASE_URL=
SUPABASE_KEY=
